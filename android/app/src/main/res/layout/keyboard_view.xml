<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kbRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sb_kb_background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/sb_kb_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/kbBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/kb_back"
            android:textColor="@color/sb_accent"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/kbTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kb_title"
                android:textColor="@color/sb_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kbSyncText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/sb_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/kbRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kb_refresh_desc"
                android:gravity="center"
                android:text="@string/kb_refresh"
                android:textColor="@color/sb_accent"
                android:textSize="22sp" />

            <ProgressBar
                android:id="@+id/kbSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tabs: Recent, Favorites, All -->
    <LinearLayout
        android:id="@+id/kbTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/sb_kb_bar"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kbTabRecent"
            style="@style/SbKeyboardTab"
            android:drawableStart="@drawable/ic_tab_recent"
            android:text="@string/kb_tab_recent" />

        <TextView
            android:id="@+id/kbTabFavorites"
            style="@style/SbKeyboardTab"
            android:drawableStart="@drawable/ic_tab_favorites"
            android:text="@string/kb_tab_favorites" />

        <TextView
            android:id="@+id/kbTabAll"
            style="@style/SbKeyboardTab"
            android:drawableStart="@drawable/ic_tab_all"
            android:text="@string/kb_tab_all" />

        <!-- Debug builds only, after running the hidden "GIF size test". -->
        <TextView
            android:id="@+id/kbTabDebug"
            style="@style/SbKeyboardTab"
            android:text="@string/kb_tab_debug"
            android:visibility="gone" />
    </LinearLayout>

    <!-- One-line hint, shown under the "In chats" tab only. -->
    <TextView
        android:id="@+id/kbHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sb_kb_background"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text="@string/kb_hint_in_chats"
        android:textColor="@color/sb_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Content -->
    <FrameLayout
        android:id="@+id/kbContent"
        android:layout_width="match_parent"
        android:layout_height="270dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/kbGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/kbMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/kbMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/sb_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/kbMessageButton"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/kb_open_app"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
